<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="prefix" default="front"/>

    <arg name="vlp16_config_file" default="$(find-pkg-share perception_bringup)/config/velodyne/$(var prefix)_lidar_nebula_driver.yaml"/>

    <node_container pkg="rclcpp_components" exec="component_container_mt" name="sensing_container" namespace="sensing" args="$(var prefix)">
        <!-- Velodyne Driver -->
        <composable_node pkg="nebula_ros" plugin="VelodyneRosWrapper" name="velodyne_driver" namespace="sensing/left_lidar">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <param name="use_intra_process_comms" value="true"/>
            <param from="$(var vlp16_config_file)" allow_substs="true"/>
            <param name="launch_hw" value="true"/>
        </composable_node>
    </node_container>
</launch>
